# 복사해서 .env 로 사용 (cp .env.example .env). .env 는 Git에 올리지 않음.
# 비밀번호는 반드시 각자 바꿔서 사용.

# 관리자(슈퍼유저) - 스키마 변경·운영용. 앱에서 직접 쓰지 않음.
POSTGRES_USER=aiax_admin
POSTGRES_PASSWORD=change_me_admin
POSTGRES_DB=aiax

# 접속 범위: 127.0.0.1(내 PC만) / 0.0.0.0(같은 네트워크 팀원 접속, 서버 모드)
POSTGRES_BIND_IP=127.0.0.1
POSTGRES_PORT=5432

# 서비스별 접속 계정 비밀번호 (계정명은 고정: app_producer, app_spark, app_ml, app_readonly)
APP_PRODUCER_PASSWORD=change_me_producer
APP_SPARK_PASSWORD=change_me_spark
APP_ML_PASSWORD=change_me_ml
APP_READONLY_PASSWORD=change_me_readonly
