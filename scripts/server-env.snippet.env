# aiax 서버의 루트 .env 에만 추가 (Windows 로컬 .env 와 섞지 말 것)
# 추가 후: systemctl restart myapp

# 브라우저→nginx same-origin. 비우면 fetch('/api/...')
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_HR_API_BASE_URL=

# 서버에서 DB 연결 타임아웃이면 호스트를 127.0.0.1 로 (docker postgres :5432)
# DATABASE_URL=postgresql://app_lake:...@127.0.0.1:5432/aiax
# HR_DATABASE_URL=postgresql://app_hr:...@127.0.0.1:5432/aiax
