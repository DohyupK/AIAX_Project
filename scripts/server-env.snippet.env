# aiax 서버의 루트 .env 전용 (Windows 로컬 .env 와 섞지 말 것)
# 전체 절차: 개발과정/서버배포_aiax.md
# 수정 후: systemctl restart myapp

# 브라우저 → https://도메인/api/... (nginx → :8000)
# 127.0.0.1 로 쓰지 말 것 (원격 PC의 localhost가 됨)
NEXT_PUBLIC_API_BASE_URL=https://gknushift.freemyip.com
NEXT_PUBLIC_HR_API_BASE_URL=https://gknushift.freemyip.com

# 서버 안 docker Postgres. 공인 IP면 ConnectionTimeout → API 503
# 비밀번호는 서버에만 두고 이 파일에는 넣지 않음. 호스트만 127.0.0.1 로:
# DATABASE_URL=postgresql://app_lake:비밀번호@127.0.0.1:5432/aiax
# HR_DATABASE_URL=postgresql://app_hr:비밀번호@127.0.0.1:5432/aiax

# 사내 문서함 (JH/api/documents) — 서버 .env 에 추가 후 systemctl restart myapp
# DOCUMENT_ROOT=/document
# DOCS_DATABASE_URL=postgresql://app_docs:비밀번호@127.0.0.1:5432/aiax
# OpenAI Embeddings 키 (채팅 아님). https://platform.openai.com/api-keys → sk-... 붙여넣기. Git에 올리지 말 것.
# OPENAI_API_KEY=
